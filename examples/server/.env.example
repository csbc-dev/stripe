# Copy to `.env` to run the server against real Stripe TEST keys.
# Leave everything unset to run in deterministic MOCK mode (no Stripe account needed).

# Stripe secret TEST key (sk_test_...). Presence of this switches the server
# from MockStripeProvider to the real StripeSdkProvider.
# STRIPE_SECRET_KEY=sk_test_xxx

# Stripe webhook signing secret (whsec_...). Only needed if you forward
# webhooks with `stripe listen --forward-to localhost:8787/webhooks/stripe`.
# NOTE: in MOCK mode (STRIPE_SECRET_KEY unset) this is IGNORED — the mock
# provider does no HMAC verification, so webhooks are skipped and the server
# warns at startup. Signature verification only runs with a real STRIPE_SECRET_KEY.
# STRIPE_WEBHOOK_SECRET=whsec_xxx

# Port the WS + webhook HTTP server listens on (default 8787).
# PORT=8787
