# Copy to `.env.local` to use real Stripe TEST keys. Unset => deterministic mock.

# Stripe publishable TEST key (pk_test_...). Presence switches the browser
# from the mock Stripe.js loader to the real one.
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# WebSocket URL of the shared Core server (default ws://localhost:8787/stripe).
# VITE_REMOTE_CORE_URL=ws://localhost:8787/stripe
